# إعدادات خادم WinAssistant المحلي والإنتاج
# JWT_SECRET: مفتاح سري عشوائي بطول 32 حرفاً على الأقل لتشفير التوكنات
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# GEMINI_API_KEY: مفتاح Google Gemini API لتخطيط الأوامر الذكية وتحليل لقطات الشاشة
# احصل عليه مجاناً من Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# GEMINI_MODEL: نموذج الذكاء الاصطناعي المستخدم للتخطيط
GEMINI_MODEL=gemini-2.5-flash

# ALLOW_REGISTRATION: السماح بإنشاء حسابات جديدة (true / false)
ALLOW_REGISTRATION=true

# DB_PATH: مسار قاعدة بيانات SQLite
DB_PATH=assistant.db

# إعدادات الشبكة للخادم المحلي
HOST=0.0.0.0
PORT=8000
